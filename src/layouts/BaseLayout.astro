---
/**
 * BaseLayout — the pure HTML shell.
 * Handles <head>, global styles, and theme attributes.
 *
 * Two-layer theming on <html>:
 *   data-project-theme  — project-level tokens (sidebar, navbar, brand) from @projects/styles
 *   data-theme          — v5 component tokens from @hubtel/shared-styles (accent, bg, text, etc.)
 *
 * Does NOT include any template (sidebar, navbar, etc.)
 * Compose this with a template-specific layout (DashboardLayout, FullWidthLayout, etc.)
 */
import "@/styles/global.css";
import type { ProjectFonts } from "@/config/types";

interface Props {
  title?: string;
  theme?: string;
  v5Theme?: string;
  description?: string;
  fonts?: ProjectFonts;
}

const {
  title = "App",
  theme = "default",
  description = "",
  v5Theme = "",
  fonts,
} = Astro.props;

const fontStyle = fonts
  ? (() => {
      const body = typeof fonts === "string" ? fonts : fonts.body;
      const heading = typeof fonts === "string" ? fonts : fonts.heading ?? body;
      return [
        body && `--font-body: ${body}`,
        heading && `--font-heading: ${heading}`,
      ]
        .filter(Boolean)
        .join("; ");
    })()
  : "";
---

<html
  lang="en"
  data-project-theme={theme}
  data-theme={v5Theme || undefined}
  style={fontStyle || undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <meta name="format-detection" content="telephone=no,email=no" />
    <title>{title}</title>
  </head>
  <body class="h-dvh">
    <slot />
  </body>
</html>
