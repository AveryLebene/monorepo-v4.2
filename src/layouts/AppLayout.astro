---
/**
 * AppLayout — single layout for all projects.
 * Uses BaseLayout + the template chosen by config.template (dashboard or fullwidth).
 */
import BaseLayout from "./BaseLayout.astro";
import DashboardTemplate from "../templates/DashboardTemplate.tsx";
import FullWidthTemplate from "../templates/FullWidthTemplate.tsx";
import type { ProjectConfig } from "../config/types";

interface Props {
  config: ProjectConfig;
  title?: string;
  showNavArrows?: boolean;
  noPadding?: string | boolean;
}

const { config, title, showNavArrows, noPadding } = Astro.props;
const pathname = Astro.url.pathname;
---

<BaseLayout
  title={title ?? config.name}
  theme={config.theme}
  v5Theme={config.v5Theme}
  fonts={config.fonts}
  description={config.name}
>
  {
    config.template === "dashboard" && (
      <DashboardTemplate
        config={config}
        pathname={pathname}
        title={title}
        showNavArrows={showNavArrows}
        noPadding={noPadding}
        client:load
      >
        <slot />
      </DashboardTemplate>
    )
  }
  {
    config.template === "fullwidth" && (
      <FullWidthTemplate config={config} pathname={pathname}>
        <slot />
      </FullWidthTemplate>
    )
  }
</BaseLayout>
