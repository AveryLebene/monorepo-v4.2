---
import AppLayout from "@/layouts/AppLayout.astro";
import { config } from "@/projects/lenders-portal/config";
---

<AppLayout config={config} title="Generating Report" showNavArrows>
  <div class="max-w-lg mx-auto py-12">
    <div class="bg-white rounded-md border border-gray-200 p-8 text-center">
      <div
        class="w-16 h-16 rounded-full bg-teal-50 flex items-center justify-center mx-auto mb-6"
      >
        <svg
          class="animate-spin"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#14b8a6"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12a9 9 0 11-6.219-8.56"></path>
        </svg>
      </div>

      <div class="text-lg font-semibold text-gray-900 mb-2">
        Generating Your Report
      </div>
      <div class="text-sm text-gray-500 mb-8">
        Please wait while we prepare your report. This may take a few moments.
      </div>

      <div class="flex flex-col gap-4 text-left max-w-xs mx-auto">
        <div class="flex items-center gap-3">
          <div
            class="w-6 h-6 rounded-full bg-teal-500 flex items-center justify-center shrink-0"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span class="text-sm text-gray-700"
            >Verifying identity information</span
          >
        </div>
        <div class="flex items-center gap-3">
          <div
            class="w-6 h-6 rounded-full bg-teal-500 flex items-center justify-center shrink-0"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span class="text-sm text-gray-700">Fetching credit data</span>
        </div>
        <div class="flex items-center gap-3">
          <div
            class="w-6 h-6 rounded-full bg-amber-100 border-2 border-amber-400 flex items-center justify-center shrink-0"
          >
            <div class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></div>
          </div>
          <span class="text-sm text-gray-700 font-medium"
            >Compiling report...</span
          >
        </div>
        <div class="flex items-center gap-3 opacity-40">
          <div
            class="w-6 h-6 rounded-full bg-gray-100 border border-gray-300 shrink-0"
          >
          </div>
          <span class="text-sm text-gray-500">Report ready for download</span>
        </div>
      </div>

      <div class="mt-8">
        <a
          href="/projects/lendscore/lenders-portal/credit-report"
          class="text-sm text-teal-500 no-underline hover:underline"
          >Go to Past Reports →</a
        >
      </div>
    </div>
  </div>
</AppLayout>
