---
import AppLayout from "@/layouts/AppLayout.astro";
import { config } from "@/projects/lenders-portal/config";
---

<AppLayout config={config} title="Credit Transactions" showNavArrows>
  <div class="mb-6">
    <div class="text-sm font-semibold text-gray-500">Non-Loan Borrowings</div>
    <div class="text-sm text-gray-400 mt-1">
      List of all credit transactions outside of standard loans
    </div>
  </div>

  <div class="overflow-x-auto">
    <table
      class="w-full min-w-[700px] border-collapse bg-white rounded-md overflow-hidden border border-gray-200"
    >
      <thead>
        <tr>
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Name</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Phone Number</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Amount</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Type</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Date</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Status</th
          >
        </tr>
      </thead>
      <tbody>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Stephen Kumi</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >050 345 6789</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >GHS 2,500.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Hire Purchase</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >18th Apr, 2023 • 10:23 AM</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Active</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Godwin Doglo</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >024 567 8901</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >GHS 8,000.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Lease</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >18th Apr, 2023 • 10:23 AM</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Active</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Abena Mensah</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >055 123 4567</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >GHS 3,200.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Trade Credit</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >18th Apr, 2023 • 10:23 AM</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-amber-600 bg-amber-50 border border-amber-200"
              >Pending</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Kwame Asante</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >020 987 6543</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >GHS 15,000.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Hire Purchase</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >18th Apr, 2023 • 10:23 AM</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Active</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700">Yaw Boateng</td>
          <td class="px-4 py-3.5 text-sm text-gray-700">054 321 0987</td>
          <td class="px-4 py-3.5 text-sm text-gray-700">GHS 5,500.00</td>
          <td class="px-4 py-3.5 text-sm text-gray-700">Overdraft</td>
          <td class="px-4 py-3.5 text-sm text-gray-700"
            >18th Apr, 2023 • 10:23 AM</td
          >
          <td class="px-4 py-3.5 text-sm"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Active</span
            ></td
          >
        </tr>
      </tbody>
    </table>
  </div>

  <div class="flex items-center justify-between py-4">
    <div class="text-sm text-gray-500">1,100 records</div>
    <div class="flex items-center gap-1">
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Previous">‹</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-teal-500 rounded-md bg-teal-500 text-white text-sm cursor-pointer"
        >1</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-700 text-sm cursor-pointer hover:bg-gray-100 transition"
        >2</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-700 text-sm cursor-pointer hover:bg-gray-100 transition"
        >3</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Next">›</button
      >
    </div>
  </div>
</AppLayout>
