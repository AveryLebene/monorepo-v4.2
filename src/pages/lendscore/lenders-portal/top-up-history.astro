---
import AppLayout from "../../../layouts/AppLayout.astro";
import { config } from "../../../projects/lenders-portal/config";
---

<AppLayout config={config} title="Transaction History" showNavArrows>
  <div class="mb-6">
    <div class="text-sm font-semibold text-gray-500">Transaction History</div>
    <div class="text-sm text-gray-400 mt-1">
      View all wallet top-up and payment transactions
    </div>
  </div>

  <div class="overflow-x-auto">
    <table
      class="w-full min-w-[700px] border-collapse bg-white rounded-xl overflow-hidden border border-gray-200"
    >
      <thead>
        <tr>
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Date</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Description</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Amount</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Type</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Status</th
          >
        </tr>
      </thead>
      <tbody>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >8th May, 2023 • 1:19 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Wallet Top-Up</td
          >
          <td
            class="px-4 py-3.5 text-sm font-medium text-emerald-600 border-b border-gray-100"
            >+ GHS 20,000.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Credit</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Completed</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >7th May, 2023 • 3:45 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Credit Report Purchase</td
          >
          <td
            class="px-4 py-3.5 text-sm font-medium text-red-600 border-b border-gray-100"
            >- GHS 150.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Debit</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Completed</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >5th May, 2023 • 11:00 AM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Wallet Top-Up</td
          >
          <td
            class="px-4 py-3.5 text-sm font-medium text-emerald-600 border-b border-gray-100"
            >+ GHS 50,000.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Credit</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Completed</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >3rd May, 2023 • 9:30 AM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Identity Report Purchase</td
          >
          <td
            class="px-4 py-3.5 text-sm font-medium text-red-600 border-b border-gray-100"
            >- GHS 75.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Debit</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Completed</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >1st May, 2023 • 2:15 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Wallet Top-Up</td
          >
          <td
            class="px-4 py-3.5 text-sm font-medium text-emerald-600 border-b border-gray-100"
            >+ GHS 10,000.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Credit</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-amber-600 bg-amber-50 border border-amber-200"
              >Pending</span
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700"
            >28th Apr, 2023 • 4:00 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700"
            >Bulk Report Purchase (5 reports)</td
          >
          <td class="px-4 py-3.5 text-sm font-medium text-red-600"
            >- GHS 750.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700">Debit</td>
          <td class="px-4 py-3.5 text-sm"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Completed</span
            ></td
          >
        </tr>
      </tbody>
    </table>
  </div>

  <div class="flex items-center justify-between py-4">
    <div class="text-sm text-gray-500">156 records</div>
    <div class="flex items-center gap-1">
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Previous">‹</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-teal-500 rounded-md bg-teal-500 text-white text-sm cursor-pointer"
        >1</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-700 text-sm cursor-pointer hover:bg-gray-100 transition"
        >2</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-700 text-sm cursor-pointer hover:bg-gray-100 transition"
        >3</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Next">›</button
      >
    </div>
  </div>
</AppLayout>
