---
import AppLayout from "@/layouts/AppLayout.astro";
import { config } from "@/projects/lenders-portal/config";
---

<AppLayout config={config} title="Bulk Downloads" showNavArrows>
  <div class="mb-6">
    <div class="text-sm font-semibold text-gray-900 mb-0.5">Bulk Downloads</div>
    <div class="text-sm text-gray-500">
      View all bulk download activities here
    </div>
  </div>

  <div class="overflow-x-auto">
    <table
      class="w-full min-w-[700px] border-collapse bg-white rounded-md overflow-hidden border border-gray-200"
    >
      <thead>
        <tr>
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Date</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >File Name</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Records</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Status</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Action</th
          >
        </tr>
      </thead>
      <tbody>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >8th May, 2023</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >borrowers-report-may-2023.xlsx</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >5,639</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Ready</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><button
              class="text-xs text-teal-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-teal-50 transition"
              >Download</button
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >5th May, 2023</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >credit-reports-apr-2023.xlsx</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >2,500</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Ready</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><button
              class="text-xs text-teal-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-teal-50 transition"
              >Download</button
            ></td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700">1st May, 2023</td>
          <td class="px-4 py-3.5 text-sm text-gray-700"
            >all-transactions-q1-2023.xlsx</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700">12,450</td>
          <td class="px-4 py-3.5 text-sm"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-blue-600 bg-blue-50 border border-blue-200"
              >Processing</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm"
            ><span class="text-xs text-gray-400">Pending...</span></td
          >
        </tr>
      </tbody>
    </table>
  </div>

  <div class="flex items-center justify-between py-4">
    <div class="text-sm text-gray-500">3 records</div>
    <div class="flex items-center gap-1">
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Previous">‹</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-teal-500 rounded-md bg-teal-500 text-white text-sm cursor-pointer"
        >1</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Next">›</button
      >
    </div>
  </div>
</AppLayout>
