---
import AppLayout from "../../../../layouts/AppLayout.astro";
import { config } from "../../../../projects/lenders-portal/config";
---

<AppLayout config={config} title="Programmable Keys" showNavArrows>
  <div class="mb-6">
    <div class="text-sm font-semibold text-gray-900 mb-0.5">
      Website/App Integration Keys
    </div>
    <div class="text-sm text-gray-500">
      Create and view all developer API keys.
    </div>
  </div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-6">
    <button
      class="inline-flex items-center gap-2 bg-teal-500 text-white rounded-md px-4 py-2 text-sm font-semibold hover:opacity-90 transition-opacity border-none cursor-pointer"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      generate api key
    </button>
  </div>

  <div class="overflow-x-auto">
    <table
      class="w-full min-w-[700px] border-collapse bg-white rounded-md overflow-hidden border border-gray-200"
    >
      <thead>
        <tr>
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Key Name</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >API Key</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Created</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Status</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Actions</th
          >
        </tr>
      </thead>
      <tbody>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Production Key</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            ><code class="text-xs bg-gray-100 px-2 py-1 rounded"
              >sk_live_••••••••••••4f2a</code
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >18th Apr, 2023</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Active</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100">
            <div class="flex items-center gap-1">
              <button
                class="text-xs text-teal-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-teal-50 transition whitespace-nowrap"
                >Copy</button
              >
              <button
                class="text-xs text-red-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-red-50 transition whitespace-nowrap"
                >Revoke</button
              >
            </div>
          </td>
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Test Key</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            ><code class="text-xs bg-gray-100 px-2 py-1 rounded"
              >sk_test_••••••••••••8b1c</code
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >12th Mar, 2023</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Active</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100">
            <div class="flex items-center gap-1">
              <button
                class="text-xs text-teal-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-teal-50 transition whitespace-nowrap"
                >Copy</button
              >
              <button
                class="text-xs text-red-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-red-50 transition whitespace-nowrap"
                >Revoke</button
              >
            </div>
          </td>
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700">Webhook Key</td>
          <td class="px-4 py-3.5 text-sm text-gray-700"
            ><code class="text-xs bg-gray-100 px-2 py-1 rounded"
              >whk_••••••••••••d93e</code
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700">5th Feb, 2023</td>
          <td class="px-4 py-3.5 text-sm"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-gray-500 bg-gray-100 border border-gray-200"
              >Revoked</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm">
            <button
              class="text-xs text-teal-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-teal-50 transition whitespace-nowrap"
              >Regenerate</button
            >
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</AppLayout>
