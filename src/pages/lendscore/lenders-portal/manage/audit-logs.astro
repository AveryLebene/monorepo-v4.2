---
import AppLayout from "@/layouts/AppLayout.astro";
import { config } from "@/projects/lenders-portal/config";
---

<AppLayout config={config} title="Audit Logs" showNavArrows>
  <div class="mb-6">
    <div class="text-sm font-semibold text-gray-500">Audit Logs</div>
    <div class="text-sm text-gray-400 mt-1">
      View all system activities and user actions
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3 mb-4">
    <div class="relative w-full max-w-[300px]">
      <svg
        class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="M21 21l-4.35-4.35"></path>
      </svg>
      <input
        type="text"
        class="border border-gray-200 rounded-md py-2.5 pl-10 pr-4 text-sm text-gray-700 bg-white w-full outline-none focus:border-teal-500 transition-colors"
        placeholder="Search logs"
      />
    </div>
    <select
      class="border border-gray-200 rounded-md py-2.5 px-4 text-sm text-gray-700 bg-white outline-none focus:border-teal-500 transition-colors"
    >
      <option value="">All Actions</option>
      <option value="login">Login</option>
      <option value="report">Report Purchase</option>
      <option value="upload">Data Upload</option>
      <option value="topup">Top Up</option>
    </select>
    <button
      class="inline-flex items-center gap-2 border border-gray-200 rounded-md px-4 py-2.5 text-sm text-gray-700 bg-white hover:bg-gray-50 transition cursor-pointer"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      Export
    </button>
  </div>

  <div class="overflow-x-auto">
    <table
      class="w-full min-w-[800px] border-collapse bg-white rounded-md overflow-hidden border border-gray-200"
    >
      <thead>
        <tr>
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Date & Time</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >User</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Action</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >Details</th
          >
          <th
            class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200"
            >IP Address</th
          >
        </tr>
      </thead>
      <tbody>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >8th May, 2023 • 1:19 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Stephen Kumi</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-blue-600 bg-blue-50 border border-blue-200"
              >Login</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Logged in successfully</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-400 border-b border-gray-100"
            >192.168.1.45</td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >8th May, 2023 • 1:25 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Stephen Kumi</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
              >Top Up</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Wallet top-up of GHS 20,000.00</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-400 border-b border-gray-100"
            >192.168.1.45</td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >7th May, 2023 • 3:45 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Godwin Doglo</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-purple-600 bg-purple-50 border border-purple-200"
              >Report</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Purchased Consumer Credit Report</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-400 border-b border-gray-100"
            >10.0.0.128</td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >7th May, 2023 • 2:00 PM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Derrick Afriyie</td
          >
          <td class="px-4 py-3.5 text-sm border-b border-gray-100"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-amber-600 bg-amber-50 border border-amber-200"
              >Upload</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100"
            >Uploaded Bank / Non-Bank Loans data</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-400 border-b border-gray-100"
            >10.0.0.64</td
          >
        </tr>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3.5 text-sm text-gray-700"
            >6th May, 2023 • 11:00 AM</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700">Stephen Kumi</td>
          <td class="px-4 py-3.5 text-sm"
            ><span
              class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-red-600 bg-red-50 border border-red-200"
              >Settings</span
            ></td
          >
          <td class="px-4 py-3.5 text-sm text-gray-700"
            >Revoked API key: Webhook Key</td
          >
          <td class="px-4 py-3.5 text-sm text-gray-400">192.168.1.45</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="flex items-center justify-between py-4">
    <div class="text-sm text-gray-500">2,340 records</div>
    <div class="flex items-center gap-1">
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Previous">‹</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-teal-500 rounded-md bg-teal-500 text-white text-sm cursor-pointer"
        >1</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-700 text-sm cursor-pointer hover:bg-gray-100 transition"
        >2</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-700 text-sm cursor-pointer hover:bg-gray-100 transition"
        >3</button
      >
      <button
        class="inline-flex items-center justify-center w-8 h-8 border border-gray-200 rounded-md bg-white text-gray-400 text-sm cursor-pointer hover:bg-gray-100 transition"
        title="Next">›</button
      >
    </div>
  </div>
</AppLayout>
