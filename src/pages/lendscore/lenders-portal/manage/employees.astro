---
import AppLayout from "../../../../layouts/AppLayout.astro";
import { config } from "../../../../projects/lenders-portal/config";
import AccessDeniedModal from "../../../../components/lenders-portal/AccessDeniedModal";
import { Pagination } from "@hubtel/react-ui/pagination";
---

<AppLayout config={config} title="Manage" showNavArrows>
  <!-- Management restriction banner (reference: platformstyles.com) -->
  <div class="flex items-start gap-2 rounded-xl bg-(--primary-light) p-3 mb-4 text-(--primary)">
    <svg class="w-5 h-5 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </svg>
    <p class="text-sm font-semibold mb-0">
      Your account is currently under management restriction. This means certain functionalities will be limited to your access.
    </p>
  </div>

  <!-- Card: All Employees -->
  <div class="bg-white border border-gray-200 rounded-md overflow-hidden mb-4">
    <div class="p-3 border-b border-gray-200 flex flex-wrap gap-3 justify-between items-start">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 mb-1">All Employees</h2>
        <p class="text-xs text-gray-500 mb-0">View a list of all employees from all branches</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          class="inline-flex items-center gap-2 border border-(--primary) rounded-md px-4 py-2.5 text-sm font-semibold text-(--primary) bg-white hover:bg-(--primary-light) transition cursor-pointer"
          id="show-filter-btn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
          </svg>
          Show Filter
        </button>
        <AccessDeniedModal client:load />
      </div>
    </div>

    <div class="px-3 py-4">
      <!-- Search + Filter panel -->
      <div class="flex flex-col sm:flex-row gap-3 mb-4">
        <div class="relative flex-1 max-w-md">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="M21 21l-4.35-4.35" />
          </svg>
          <input
            type="text"
            class="border border-gray-200 rounded-md py-2.5 pl-10 pr-4 text-sm text-gray-700 bg-white w-full outline-none focus:border-(--primary) transition-colors"
            placeholder="Search"
          />
        </div>
      </div>

      <div id="filter-panel" class="hidden mb-4 p-4 bg-gray-50 rounded-md border border-gray-200">
        <div class="text-sm font-semibold text-gray-700 mb-3">Filter By</div>
        <div class="flex flex-wrap items-end gap-3">
          <div>
            <label for="permission-select" class="block text-xs text-gray-500 mb-1">Select permission</label>
            <select
              id="permission-select"
              class="border border-gray-200 rounded-md py-2.5 px-4 text-sm text-gray-700 bg-white outline-none focus:border-(--primary) min-w-160px"
            >
              <option value="">All permissions</option>
              <option value="all-access">All Access</option>
              <option value="view-only">View Only</option>
            </select>
          </div>
          <div class="flex gap-2">
            <button type="button" class="border border-gray-200 rounded-md px-4 py-2.5 text-sm text-gray-700 bg-white hover:bg-gray-50 cursor-pointer" id="reset-filter-btn">
              Reset Filter
            </button>
            <button type="button" class="bg-(--primary) text-white rounded-md px-4 py-2.5 text-sm font-semibold hover:opacity-90 border-none cursor-pointer" id="apply-filter-btn">
              Apply
            </button>
          </div>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[800px] border-collapse bg-white rounded-md border border-gray-200">
          <thead>
            <tr>
              <th class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200">Full Name</th>
              <th class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200">Phone Number</th>
              <th class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200">Email</th>
              <th class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200">Permission</th>
              <th class="text-left px-4 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 border-b border-gray-200 w-0" />
            </tr>
          </thead>
          <tbody>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">Ben-Aaron Kpakpo Mills-Pappoe</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">050 345 6789</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">email@gmail.com</td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100"><span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200">View Only</span></td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100">
                <div class="flex items-center gap-1 flex-wrap">
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">View Employee Details</button>
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">Edit Employee Details</button>
                  <button type="button" class="text-xs text-red-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-red-50 whitespace-nowrap">Remove Employee</button>
                </div>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">Ben-Aaron Kpakpo Mills-Pappoe</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">050 345 6789</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">email@gmail.com</td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100"><span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200">All access</span></td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100">
                <div class="flex items-center gap-1 flex-wrap">
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">View Employee Details</button>
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">Edit Employee Details</button>
                  <button type="button" class="text-xs text-red-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-red-50 whitespace-nowrap">Remove Employee</button>
                </div>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">Ben-Aaron Kpakpo Mills-Pappoe</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">050 345 6789</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">email@gmail.com</td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100"><span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200">View Only</span></td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100">
                <div class="flex items-center gap-1 flex-wrap">
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">View Employee Details</button>
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">Edit Employee Details</button>
                  <button type="button" class="text-xs text-red-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-red-50 whitespace-nowrap">Remove Employee</button>
                </div>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">Stephen Kumi</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">050 345 6789</td>
              <td class="px-4 py-3.5 text-sm text-gray-700 border-b border-gray-100">stephen.kumi@deals2d.com</td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100"><span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200">All access</span></td>
              <td class="px-4 py-3.5 text-sm border-b border-gray-100">
                <div class="flex items-center gap-1 flex-wrap">
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">View Employee Details</button>
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">Edit Employee Details</button>
                  <button type="button" class="text-xs text-red-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-red-50 whitespace-nowrap">Remove Employee</button>
                </div>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3.5 text-sm text-gray-700">Godwin Doglo</td>
              <td class="px-4 py-3.5 text-sm text-gray-700">050 345 6789</td>
              <td class="px-4 py-3.5 text-sm text-gray-700">godwin.doglo@deals2d.com</td>
              <td class="px-4 py-3.5 text-sm"><span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200">View Only</span></td>
              <td class="px-4 py-3.5 text-sm">
                <div class="flex items-center gap-1 flex-wrap">
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">View Employee Details</button>
                  <button type="button" class="text-xs text-(--primary) bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-(--primary-light) whitespace-nowrap">Edit Employee Details</button>
                  <button type="button" class="text-xs text-red-500 bg-transparent border-none cursor-pointer px-2 py-1 rounded hover:bg-red-50 whitespace-nowrap">Remove Employee</button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <Pagination
        client:load
        variant="default"
        page={1}
        pageSize={10}
        totalRecords={5639}
        onPageChange={() => {}}
        onPageSizeChange={() => {}}
      />
    </div>
  </div>

  <script>
    document.getElementById("show-filter-btn")?.addEventListener("click", () => {
      document.getElementById("filter-panel")?.classList.toggle("hidden");
    });
    document.getElementById("reset-filter-btn")?.addEventListener("click", () => {
      const sel = document.getElementById("permission-select");
      if (sel instanceof HTMLSelectElement) sel.value = "";
    });
  </script>
</AppLayout>
