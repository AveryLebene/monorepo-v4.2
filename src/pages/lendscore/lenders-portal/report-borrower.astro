---
import AppLayout from "../../../layouts/AppLayout.astro";
import { config } from "../../../projects/lenders-portal/config";
import { Pagination } from "@hubtel/react-ui/pagination";
---

<AppLayout config={config} title="Report A Loan">
  <!-- Header with tabs + button -->
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4"
  >
    <div class="flex border-b border-gray-200">
      <button
        class="px-4 py-2.5 text-sm font-medium text-primary border-b-2 border-primary bg-transparent cursor-pointer"
        >Other Borrowers Debt</button
      >
      <button
        class="px-4 py-2.5 text-sm font-medium text-gray-400 border-b-2 border-transparent bg-transparent cursor-pointer hover:text-gray-600"
        >Report A Borrower</button
      >
    </div>
    <a
      href="/lendscore/lenders-portal/credit-transactions"
      class="inline-flex items-center justify-center gap-2 bg-primary text-white rounded-md px-5 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity no-underline whitespace-nowrap"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      Add New Transaction
    </a>
