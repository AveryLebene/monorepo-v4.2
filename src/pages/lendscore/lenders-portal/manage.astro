---
import AppLayout from "@/layouts/AppLayout.astro";
import { config } from "@/projects/lenders-portal/config";
---

<AppLayout config={config} title="Manage">
  <div class="flex flex-col gap-4 max-w-4xl m-auto">
    <!-- All Employees -->
    <a
      href="/projects/lendscore/lenders-portal/manage/employees"
      class="bg-white border border-gray-200 rounded-md p-6 no-underline text-inherit flex items-center gap-4 hover:border-teal-500 hover:shadow-sm transition cursor-pointer group"
    >
      <div
        class="w-12 h-12 rounded-md bg-gray-50 flex items-center justify-center text-gray-500 shrink-0"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 00-3-3.87"></path>
          <path d="M16 3.13a4 4 0 010 7.75"></path>
        </svg>
      </div>
      <div class="flex-1">
        <div class="text-sm font-semibold text-gray-900">All Employees</div>
        <div class="text-xs text-gray-500 mt-0.5">
          Add, remove and update details of staff added on the portal.
        </div>
      </div>
      <svg
        class="text-gray-300 group-hover:text-teal-500 transition shrink-0"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </a>

    <!-- Programmable Keys -->
    <a
      href="/projects/lendscore/lenders-portal/manage/api-keys"
      class="bg-white border border-gray-200 rounded-md p-6 no-underline text-inherit flex items-center gap-4 hover:border-teal-500 hover:shadow-sm transition cursor-pointer group"
    >
      <div
        class="w-12 h-12 rounded-md bg-gray-50 flex items-center justify-center text-gray-500 shrink-0"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
        </svg>
      </div>
      <div class="flex-1">
        <div class="text-sm font-semibold text-gray-900">Programmable keys</div>
        <div class="text-xs text-gray-500 mt-0.5">
          Create and view all developer API keys.
        </div>
      </div>
      <svg
        class="text-gray-300 group-hover:text-teal-500 transition shrink-0"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </a>

    <!-- Audit Logs -->
    <a
      href="/projects/lendscore/lenders-portal/manage/audit-logs"
      class="bg-white border border-gray-200 rounded-md p-6 no-underline text-inherit flex items-center gap-4 hover:border-teal-500 hover:shadow-sm transition cursor-pointer group"
    >
      <div
        class="w-12 h-12 rounded-md bg-gray-50 flex items-center justify-center text-gray-500 shrink-0"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"
          ></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
      </div>
      <div class="flex-1">
        <div class="text-sm font-semibold text-gray-900">Audit Logs</div>
        <div class="text-xs text-gray-500 mt-0.5">
          View and download records of all system activities.
        </div>
      </div>
      <svg
        class="text-gray-300 group-hover:text-teal-500 transition shrink-0"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </a>

    <!-- Bulk Downloads -->
    <a
      href="/projects/lendscore/lenders-portal/manage/bulk-downloads"
      class="bg-white border border-gray-200 rounded-md p-6 no-underline text-inherit flex items-center gap-4 hover:border-teal-500 hover:shadow-sm transition cursor-pointer group"
    >
      <div
        class="w-12 h-12 rounded-md bg-gray-50 flex items-center justify-center text-gray-500 shrink-0"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </div>
      <div class="flex-1">
        <div class="text-sm font-semibold text-gray-900">Bulk Downloads</div>
        <div class="text-xs text-gray-500 mt-0.5">
          View all bulk download activities here
        </div>
      </div>
      <svg
        class="text-gray-300 group-hover:text-teal-500 transition shrink-0"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </a>

    <!-- API Documentation -->
    <a
      href="/projects/lendscore/lenders-portal/manage/api-docs"
      class="bg-white border border-gray-200 rounded-md p-6 no-underline text-inherit flex items-center gap-4 hover:border-teal-500 hover:shadow-sm transition cursor-pointer group"
    >
      <div
        class="w-12 h-12 rounded-md bg-gray-50 flex items-center justify-center text-gray-500 shrink-0"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
          <polyline points="7 8 10 11 7 14"></polyline>
          <line x1="13" y1="14" x2="17" y2="14"></line>
        </svg>
      </div>
      <div class="flex-1">
        <div class="text-sm font-semibold text-gray-900">Api Documentation</div>
        <div class="text-xs text-gray-500 mt-0.5">
          View API Documentation here
        </div>
      </div>
      <svg
        class="text-gray-300 group-hover:text-teal-500 transition shrink-0"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </a>
  </div>
</AppLayout>
