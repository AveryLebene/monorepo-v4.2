---
import AppLayout from "@/layouts/AppLayout.astro";
import { config } from "@/projects/lenders-portal/config";
import { Pagination } from "@hubtel/react-ui/pagination";
---

<AppLayout config={config} title="New Loans/Debt">
  <div class="mb-4">
    <div class="text-sm text-gray-400">
      Upload loan data in the Bank of Ghana approved format
    </div>
  </div>

  <!-- Search + Filter + Upload row -->
  <div
    class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-5"
  >
    <div class="relative flex-1 max-w-md">
      <svg
        class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="M21 21l-4.35-4.35"></path>
      </svg>
      <input
        type="text"
        class="border border-gray-200 rounded-md py-2.5 pl-10 pr-8 text-sm text-gray-700 bg-white w-full outline-none focus:border-teal-500 transition-colors"
        placeholder="Enter file name"
      />
      <button
        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 bg-transparent border-none cursor-pointer p-0"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <button
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 border border-gray-200 rounded-md bg-white text-gray-700 text-sm cursor-pointer hover:border-teal-500 transition whitespace-nowrap"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="4" y1="21" x2="4" y2="14"></line>
        <line x1="4" y1="10" x2="4" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12" y2="3"></line>
        <line x1="20" y1="21" x2="20" y2="16"></line>
        <line x1="20" y1="12" x2="20" y2="3"></line>
      </svg>
      SHOW FILTER
    </button>
    <a
      href="/projects/lendscore/lenders-portal/upload-data"
      class="inline-flex items-center justify-center gap-2 bg-primary text-white rounded-md px-5 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity no-underline whitespace-nowrap ml-auto"
      >UPLOAD NEW DATA</a
    >
  </div>

  <!-- Cards list -->
  <div class="flex flex-col gap-4">
    <!-- Card 1: Waiting in Queue -->
    <div class="bg-white border border-gray-200 rounded-md p-5 relative">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-xs text-primary mb-1">Date of Upload</div>
          <div class="text-sm text-gray-800">18th Oct, 2023•10:23 AM</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">File Name</div>
          <div class="text-sm text-gray-800">
            10118-20120130-20120205-1.1-CONC-12.xlsx
          </div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Total Record</div>
          <div class="text-sm text-gray-800">--</div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-primary mb-1">Upload Source</div>
          <div class="text-sm text-gray-800">Newdata Input</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Status</div>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium text-amber-600 bg-amber-50 border border-amber-200"
            ><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            Waiting in Queue</span
          >
        </div>
      </div>
      <button
        class="absolute top-4 right-4 bg-transparent border-none cursor-pointer text-gray-400 hover:text-gray-600 p-1"
        title="More actions"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="5" r="2"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <circle cx="12" cy="19" r="2"></circle>
        </svg>
      </button>
    </div>

    <!-- Card 2: File not uploaded -->
    <div class="bg-white border border-gray-200 rounded-md p-5 relative">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-xs text-primary mb-1">Date of Upload</div>
          <div class="text-sm text-gray-800">18th Oct, 2023•10:23 AM</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">File Name</div>
          <div class="text-sm text-gray-800">
            10118-20120130-20120205-1.1-CONC-12.xlsx
          </div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Total Record</div>
          <div class="text-sm text-gray-800">--</div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-primary mb-1">Upload Source</div>
          <div class="text-sm text-gray-800">FTP</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Status</div>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium text-red-600 bg-red-50 border border-red-200"
            ><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
            File not uploaded</span
          >
        </div>
      </div>
      <button
        class="absolute top-4 right-4 bg-transparent border-none cursor-pointer text-gray-400 hover:text-gray-600 p-1"
        title="More actions"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="5" r="2"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <circle cx="12" cy="19" r="2"></circle>
        </svg>
      </button>
    </div>

    <!-- Card 3: Processing -->
    <div class="bg-white border border-gray-200 rounded-md p-5 relative">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-xs text-primary mb-1">Date of Upload</div>
          <div class="text-sm text-gray-800">18th Oct, 2023•10:23 AM</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">File Name</div>
          <div class="text-sm text-gray-800">
            10118-20120130-20120205-1.1-CONC-12.xlsx
          </div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Total Record</div>
          <div class="text-sm text-gray-800">--</div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-primary mb-1">Upload Source</div>
          <div class="text-sm text-gray-800">Newdata Input</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Status</div>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium text-blue-600 bg-blue-50 border border-blue-200"
            ><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            Processing</span
          >
        </div>
      </div>
      <button
        class="absolute top-4 right-4 bg-transparent border-none cursor-pointer text-gray-400 hover:text-gray-600 p-1"
        title="More actions"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="5" r="2"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <circle cx="12" cy="19" r="2"></circle>
        </svg>
      </button>
    </div>

    <!-- Card 4: Completed With Errors -->
    <div class="bg-white border border-gray-200 rounded-md p-5 relative">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-xs text-primary mb-1">Date of Upload</div>
          <div class="text-sm text-gray-800">18th Oct, 2023•10:23 AM</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">File Name</div>
          <div class="text-sm text-gray-800">
            10118-20120130-20120205-1.1-CONC-12.xlsx
          </div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Total Record</div>
          <div class="text-sm text-gray-800">--</div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-primary mb-1">Upload Source</div>
          <div class="text-sm text-gray-800">Newdata Input</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Status</div>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium text-red-600 bg-red-50 border border-red-200"
            ><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
            Completed With Errors</span
          >
        </div>
      </div>
      <button
        class="absolute top-4 right-4 bg-transparent border-none cursor-pointer text-gray-400 hover:text-gray-600 p-1"
        title="More actions"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="5" r="2"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <circle cx="12" cy="19" r="2"></circle>
        </svg>
      </button>
    </div>

    <!-- Card 5: Completed -->
    <div class="bg-white border border-gray-200 rounded-md p-5 relative">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-xs text-primary mb-1">Date of Upload</div>
          <div class="text-sm text-gray-800">18th Oct, 2023•10:23 AM</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">File Name</div>
          <div class="text-sm text-gray-800">
            10118-20120130-20120205-1.1-CONC-12.xlsx
          </div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Total Record</div>
          <div class="text-sm text-gray-800">--</div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-primary mb-1">Upload Source</div>
          <div class="text-sm text-gray-800">Newdata Input</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Status</div>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
            ><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Completed</span
          >
        </div>
      </div>
      <button
        class="absolute top-4 right-4 bg-transparent border-none cursor-pointer text-gray-400 hover:text-gray-600 p-1"
        title="More actions"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="5" r="2"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <circle cx="12" cy="19" r="2"></circle>
        </svg>
      </button>
    </div>

    <!-- Card 6: Completed -->
    <div class="bg-white border border-gray-200 rounded-md p-5 relative">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-xs text-primary mb-1">Date of Upload</div>
          <div class="text-sm text-gray-800">18th Oct, 2023•10:23 AM</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">File Name</div>
          <div class="text-sm text-gray-800">
            10118-20120130-20120205-1.1-CONC-12.xlsx
          </div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Total Record</div>
          <div class="text-sm text-gray-800">--</div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-primary mb-1">Upload Source</div>
          <div class="text-sm text-gray-800">Newdata Input</div>
        </div>
        <div>
          <div class="text-xs text-primary mb-1">Status</div>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium text-emerald-600 bg-emerald-50 border border-emerald-200"
            ><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Completed</span
          >
        </div>
      </div>
      <button
        class="absolute top-4 right-4 bg-transparent border-none cursor-pointer text-gray-400 hover:text-gray-600 p-1"
        title="More actions"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="5" r="2"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <circle cx="12" cy="19" r="2"></circle>
        </svg>
      </button>
    </div>
  </div>

  <Pagination
    onPageChange={function tG() {}}
    onPageSizeChange={function tG() {}}
    page={1}
    pageSize={10}
    totalRecords={100}
    variant="default"
  />
</AppLayout>
